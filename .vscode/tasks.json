{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "cppbuild",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/src/*.c",
                "${workspaceFolder}/src/structs/*.c",
                "${workspaceFolder}/src/estados/*.c",
                "${workspaceFolder}/src/estados/config/*.c",
                "${workspaceFolder}/src/estados/inicial/*.c",
                "${workspaceFolder}/src/estados/pagar/*.c",
                "${workspaceFolder}/src/estados/selecionar/*.c",
                "${workspaceFolder}/src/gerenciadores/moedas/*.c",
                "${workspaceFolder}/src/gerenciadores/propaganda/*.c",
                "${workspaceFolder}/src/gerenciadores/produtos/*.c",
                "${workspaceFolder}/src/gerenciadores/admin/*.c",
                "-I${workspaceFolder}/src/",
                "-I${workspaceFolder}/src/structs/",
                "-I${workspaceFolder}/src/estados/",
                "-I${workspaceFolder}/src/estados/config/",
                "-I${workspaceFolder}/src/estados/inicial/",
                "-I${workspaceFolder}/src/estados/pagar/",
                "-I${workspaceFolder}/src/estados/selecionar/",
                "-I${workspaceFolder}/src/gerenciadores/moedas/",
                "-I${workspaceFolder}/src/gerenciadores/propaganda/",                
                "-I${workspaceFolder}/src/gerenciadores/produtos/",
                "-I${workspaceFolder}/src/gerenciadores/admin/",                
                "-o",
                "${workspaceFolder}/rel/app.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}