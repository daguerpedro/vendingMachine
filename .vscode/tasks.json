{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "cppbuild",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",

                "-g",
                "${workspaceFolder}/src/*.c",
                "${workspaceFolder}/src/modules/*.c",
                "${workspaceFolder}/src/modules/states/*.c",
                "${workspaceFolder}/src/data/*.c",

                "-I${workspaceFolder}/src/",
                "-I${workspaceFolder}/src/modules/",
                "-I${workspaceFolder}/src/modules/states/",
                "-I${workspaceFolder}/src/data/",

                "-DDEBUG",
                
                "-o",
                "${workspaceFolder}/rel/app.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}